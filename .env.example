# --- Database ---
DATABASE_URL="postgresql://texbanner:texbanner@localhost:5432/texbanner"

# Public URL of the shop (used for Konnect webhook / return URLs). Must be HTTPS in production.
APP_URL="http://localhost:3000"

# --- Konnect (https://dashboard.sandbox.konnect.network → Integration) ---
KONNECT_ENV="sandbox"            # sandbox | production
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""
# KONNECT_BASE_URL=""            # optional override (e.g. a local mock for tests)

# --- Admin (HTTP Basic auth on /admin) ---
ADMIN_USER="admin"
ADMIN_PASSWORD=""                # use a long random password

# --- Storage & shipping ---
UPLOAD_DIR="./storage/uploads"   # customer logos (private)
MEDIA_DIR="./storage/media"      # catalog photos uploaded from the admin (public)
SHIPPING_FLAT_MILLIMES=8000      # 8 DT
FREE_SHIPPING_FROM_MILLIMES=200000  # free shipping from 200 DT
TZ="Africa/Tunis"
SEED_ON_START=1                  # loads the initial catalog at first start (idempotent)
MAINTENANCE="0"                  # 1 = visitors coming from the internet see the maintenance page
