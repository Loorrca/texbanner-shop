# Copy to .env next to docker-compose.pi.yml on the Raspberry Pi, then fill it in.
# Careful: Next.js expands $NAME inside values — write a literal $ as \$, or avoid $.

# Image built by GitHub Actions (lowercase GitHub user / repository)
IMAGE="ghcr.io/<github-user>/texbanner-shop:latest"

# Database password (used by both containers)
POSTGRES_PASSWORD="change-this-long-password"

# Address customers use — the public https address once the tunnel is up.
# Local network only (no payments): http://<pi-ip>:3000
APP_URL="https://texbanner.com"

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Configure).
# It is a long string; treat it like a password.
TUNNEL_TOKEN=""

# --- Konnect ---
KONNECT_ENV="sandbox"
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""

# --- Admin (/admin) ---
ADMIN_USER="admin"
ADMIN_PASSWORD="change-this-password"

# --- Shop settings ---
SHIPPING_FLAT_MILLIMES=8000
FREE_SHIPPING_FROM_MILLIMES=200000
TZ="Africa/Tunis"

# Set to 0 once the catalog is set up, to skip the seed check at every start
SEED_ON_START=1
