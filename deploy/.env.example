# Copy to .env next to docker-compose.pi.yml on the Raspberry Pi, then fill it in.
# Careful: Next.js expands $NAME inside values — write a literal $ as \$, or avoid $.

# Image built by GitHub Actions (lowercase GitHub user / repository)
IMAGE="ghcr.io/<github-user>/texbanner-shop:latest"

# Database password (used by both containers)
POSTGRES_PASSWORD="change-this-long-password"

# Address customers use — the public https address once the tunnel is up.
# Local network only (no payments): http://<pi-ip>:3000
APP_URL="https://texbanner.com"

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Configure).
# It is a long string; treat it like a password.
TUNNEL_TOKEN=""

# --- Konnect ---
KONNECT_ENV="sandbox"
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""

# --- Admin (/admin) ---
ADMIN_USER="admin"
ADMIN_PASSWORD="change-this-password"

# --- Shop settings ---
SHIPPING_FLAT_MILLIMES=8000
FREE_SHIPPING_FROM_MILLIMES=200000
TZ="Africa/Tunis"

# Set to 0 once the catalog is set up, to skip the seed check at every start
SEED_ON_START=1

# 1 = public visitors see the "boutique en maintenance" page, while the local network,
# /admin and payment callbacks keep working. Use ./maintenance.sh on|off instead of editing this.
MAINTENANCE="0"

# --- Devis (demandes de devis) ---
# Quantity from which the shop suggests a quote instead of a direct order
QUOTE_THRESHOLD_QTY=20
# Where quote notifications are sent (defaults to the shop address in src/lib/config.ts)
QUOTE_NOTIFY_EMAIL=""
# SMTP for those notifications. Leave SMTP_HOST empty to disable mail entirely:
# quotes are still saved and visible in /admin/quotes.
# Gmail: smtp.gmail.com / 587, SMTP_USER = the address, SMTP_PASSWORD = an app password
# (Google account → 2-step verification → App passwords), NOT the account password.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
